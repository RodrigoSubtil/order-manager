{
  "name": "@order-manager/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "db:check": "tsx prisma/check-connection.ts",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "legacy:migrate": "tsx prisma/legacy/cli.ts",
    "legacy:rehearse": "tsx prisma/legacy/rehearse.ts",
    "openapi:generate": "jest --config jest.config.cjs --runInBand --testPathPatterns openapi-generation",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:dev": "tsx prisma/run-migration.ts dev",
    "prisma:migrate:reset": "tsx prisma/run-migration.ts reset",
    "prisma:migrate:staging": "tsx prisma/run-staging-migration.ts",
    "prisma:seed": "prisma db seed --config prisma.config.ts",
    "start": "node dist/main.js",
    "test": "npm run prisma:generate && jest --config jest.config.cjs --runInBand",
    "test:coverage": "npm run prisma:generate && jest --config jest.config.cjs --runInBand --coverage",
    "test:integration:db": "npm run prisma:generate && jest --config jest.database.config.cjs --runInBand",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.67.0",
    "@supabase/supabase-js": "^2.110.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1"
  }
}
