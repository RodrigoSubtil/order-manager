generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REVOKED
}

enum ProductCategory {
  PASTELARIA
  PADARIA
  SALGADOS
}

enum QuantityUnit {
  UN
  KG
  G
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique
  name            String
  status          TenantStatus @default(ACTIVE)
  nextOrderNumber BigInt       @default(1) @map("next_order_number")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     String?      @map("created_by") @db.Uuid
  updatedById     String?      @map("updated_by") @db.Uuid

  memberships     TenantMembership[]
  settings        TenantSettings?
  orders          Order[]
  catalogProducts CatalogProduct[]
  responsibles    Responsible[]
  auditLogs       AuditLog[]

  @@map("tenants")
}

model User {
  id          String     @id @db.Uuid
  displayName String     @map("display_name")
  email       String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships TenantMembership[]
  auditLogs   AuditLog[]

  @@map("users")
}

model TenantMembership {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        MembershipRole
  status      MembershipStatus @default(INVITED)
  isDefault   Boolean          @default(false) @map("is_default")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?          @map("created_by") @db.Uuid
  updatedById String?          @map("updated_by") @db.Uuid
  revokedAt   DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedById String?          @map("revoked_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status, role])
  @@map("tenant_memberships")
}

model TenantSettings {
  tenantId          String   @id @map("tenant_id") @db.Uuid
  timezone          String
  locale            String
  orderRetentionDays Int?    @map("order_retention_days")
  printPreferences  Json     @default("{}") @map("print_preferences")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?  @map("created_by") @db.Uuid
  updatedById       String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Responsible {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  isActive    Boolean   @default(true) @map("is_active")
  position    Int       @default(0)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedById String?   @map("deleted_by") @db.Uuid

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders Order[] @relation("OrderResponsible")

  @@unique([tenantId, id])
  @@index([tenantId, position, name])
  @@map("responsibles")
}

model CatalogProduct {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  category    ProductCategory
  name        String
  defaultUnit QuantityUnit    @default(UN) @map("default_unit")
  isActive    Boolean         @default(true) @map("is_active")
  position    Int             @default(0)
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdById String?         @map("created_by") @db.Uuid
  updatedById String?         @map("updated_by") @db.Uuid
  deletedById String?         @map("deleted_by") @db.Uuid

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderItems OrderItem[] @relation("OrderItemCatalogProduct")

  @@unique([tenantId, id])
  @@index([tenantId, category, position, name])
  @@map("catalog_products")
}

model Order {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  orderNumber   BigInt    @map("order_number")
  clientName    String    @map("client_name")
  phone         String?
  responsibleId String?   @map("responsible_id") @db.Uuid
  deliveryDate  DateTime  @map("delivery_date") @db.Date
  deliveryTime  DateTime? @map("delivery_time") @db.Time(6)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById   String?   @map("created_by") @db.Uuid
  updatedById   String?   @map("updated_by") @db.Uuid
  deletedById   String?   @map("deleted_by") @db.Uuid

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  responsible Responsible? @relation("OrderResponsible", fields: [tenantId, responsibleId], references: [tenantId, id], onDelete: Restrict)
  items       OrderItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, orderNumber])
  @@index([tenantId, deliveryDate, deliveryTime])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  catalogProductId String?         @map("catalog_product_id") @db.Uuid
  category         ProductCategory
  productName      String          @map("product_name")
  quantityValue    Decimal         @map("quantity_value") @db.Decimal(12, 3)
  quantityUnit     QuantityUnit    @map("quantity_unit")
  notes            String?
  position         Int
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdById      String?         @map("created_by") @db.Uuid
  updatedById      String?         @map("updated_by") @db.Uuid
  deletedById      String?         @map("deleted_by") @db.Uuid

  order          Order           @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  catalogProduct CatalogProduct? @relation("OrderItemCatalogProduct", fields: [tenantId, catalogProductId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderId, position])
  @@map("order_items")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  requestId   String?  @map("request_id") @db.Uuid
  metadata    Json     @default("{}")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_logs")
}
