# Development-only defaults. In production, use explicit HTTPS origins and set
# API_SWAGGER_ENABLED=false. Never commit real keys in this file.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_LIMIT=100
API_SWAGGER_ENABLED=true
LOG_LEVEL=info
# Keep disabled locally unless a monitoring collector is configured. When enabled,
# METRICS_AUTH_TOKEN must be a secret with at least 32 characters.
METRICS_ENABLED=false
METRICS_AUTH_TOKEN=
# Sentry is opt-in. The DSN is public but must be configured only in deployment variables.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
DATABASE_URL=postgresql://order_manager:order_manager@localhost:5432/order_manager_dev?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key-only
# Backend-only; required only when the invitation endpoint is enabled.
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key
SUPABASE_INVITE_REDIRECT_URL=http://localhost:5173/accept-invite
# Optional. In staging/production this must be an allowed HTTPS redirect URL configured in Supabase Auth.
SUPABASE_PASSWORD_RECOVERY_REDIRECT_URL=http://localhost:5173/reset-password
SESSION_CONTEXT_SECRET=replace-with-at-least-32-random-characters
TENANT_CONTEXT_TTL_SECONDS=86400
