# URL pública da API NestJS. Em produção pode ficar vazia quando a API estiver no mesmo domínio.
VITE_API_BASE_URL=http://localhost:3000

# Opcional: ativa os mocks MSW apenas no desenvolvimento local.
VITE_ENABLE_MSW=false

# Sentry is opt-in. DSN is public, but keep it in the deployment environment.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
