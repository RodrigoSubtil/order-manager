{
  "name": "@order-manager/web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner --config vitest.config.mjs",
    "test:watch": "vitest --configLoader runner --config vitest.config.mjs",
    "test:coverage": "vitest run --configLoader runner --config vitest.config.mjs --coverage",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@sentry/react": "^10.67.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.2",
    "libphonenumber-js": "^1.13.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.81.0",
    "zod": "4.6.6"
  }
}
