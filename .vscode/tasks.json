{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": [
          {
            "regexp": ".*"
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "npm: quality",
      "dependsOrder": "sequence",
      "dependsOn": ["npm: format:check", "npm: lint", "npm: typecheck", "npm: test", "npm: build"]
    },
    {
      "label": "npm: format:check",
      "type": "npm",
      "script": "format:check",
      "problemMatcher": []
    },
    {
      "label": "npm: lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": []
    },
    {
      "label": "npm: typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": []
    },
    {
      "label": "npm: test",
      "type": "npm",
      "script": "test",
      "problemMatcher": []
    },
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    }
  ]
}
