{
  "name": "order-manager-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @order-manager/web",
    "dev:web": "npm run dev --workspace @order-manager/web",
    "dev:api": "npm run dev --workspace @order-manager/api",
    "docker:dev": "docker compose -f compose.dev.yml --profile app up --build",
    "docker:down": "docker compose -f compose.dev.yml --profile app down",
    "docker:test": "docker compose -f compose.test.yml --profile tests up --build --abort-on-container-exit",
    "docker:test:down": "docker compose -f compose.test.yml --profile tests down --volumes",
    "docker:config": "docker compose -f compose.dev.yml config",
    "db:up": "docker compose -f compose.dev.yml up -d postgres",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:reset": "npm run prisma:migrate:reset --workspace @order-manager/api -- --force && npm run prisma:seed --workspace @order-manager/api",
    "test:db": "npm run test:integration:db --workspace @order-manager/api",
    "api:openapi": "npm run openapi:generate --workspace @order-manager/api",
    "api:generate": "npm run api:openapi && npm run generate --workspace @order-manager/api-client && prettier --write apps/api/openapi.json packages/api-client/src/generated",
    "api:check": "npm run api:generate && git diff --exit-code -- apps/api/openapi.json packages/api-client/src/generated",
    "security:check": "node scripts/security-check.mjs",
    "migration:staging:gate": "node scripts/verify-staging-migration-gate.mjs",
    "build": "npm run build --workspace @order-manager/web && npm run build --workspace @order-manager/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace @order-manager/web && npm run lint --workspace @order-manager/api",
    "lint:js": "npm run lint:js --workspace @order-manager/web",
    "lint:css": "npm run lint:css --workspace @order-manager/web",
    "migration:legacy": "npm run legacy:migrate --workspace @order-manager/api --",
    "migration:legacy:rehearse": "npm run legacy:rehearse --workspace @order-manager/api",
    "preview": "npm run preview --workspace @order-manager/web",
    "test": "npm run test --workspace @order-manager/web && npm run test --workspace @order-manager/api",
    "test:watch": "npm run test:watch --workspace @order-manager/web",
    "test:coverage": "npm run test:coverage --workspace @order-manager/web",
    "test:coverage:api": "npm run test:coverage --workspace @order-manager/api",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspace @order-manager/api-client && npm run typecheck --workspace @order-manager/web && npm run typecheck --workspace @order-manager/api"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^29.1.1",
    "orval": "^7.13.2",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
