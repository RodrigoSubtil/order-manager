{
  "name": "order-manager-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @order-manager/web",
    "dev:web": "npm run dev --workspace @order-manager/web",
    "build": "npm run build --workspace @order-manager/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace @order-manager/web",
    "lint:js": "npm run lint:js --workspace @order-manager/web",
    "lint:css": "npm run lint:css --workspace @order-manager/web",
    "preview": "npm run preview --workspace @order-manager/web",
    "test": "npm run test --workspace @order-manager/web",
    "test:watch": "npm run test:watch --workspace @order-manager/web",
    "test:coverage": "npm run test:coverage --workspace @order-manager/web",
    "typecheck": "npm run typecheck --workspace @order-manager/web"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^29.1.1",
    "postcss": "8.5.18",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
